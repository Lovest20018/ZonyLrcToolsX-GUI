<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZonyLrcTools.Desktop.ViewModels"
             x:Class="ZonyLrcTools.Desktop.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <StackPanel Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="32"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Description}"
                           FontSize="14"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Quick Actions -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="开始使用"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <WrapPanel Orientation="Horizontal">
                        <Button Margin="0,0,16,16"
                                Command="{Binding NavigateCommand}" CommandParameter="1"
                                Padding="24,16"
                                CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="批量下载歌词"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="扫描音乐文件夹，保存同名 .lrc"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,16,16"
                                Command="{Binding NavigateCommand}" CommandParameter="4"
                                Padding="24,16"
                                CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="单曲匹配与预览"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="输入歌名和歌手，预览后保存"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Features -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="使用提示"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <ItemsControl>
                        <ItemsControl.Items>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                <TextBlock Text="*" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="支持网易云、QQ 音乐、酷狗、酷我，按优先级自动尝试。" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                <TextBlock Text="*" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="歌曲识别优先读取标签；无标签时，使用“歌手 - 歌名”的文件名。" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                <TextBlock Text="*" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="可设置翻译、双语合并、文件编码和已有歌词跳过。" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                <TextBlock Text="*" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="建议并行数为 1～2。遇到失败可重试，或在运行日志中查看原因。" />
                            </StackPanel>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Version Info -->
            <Button Content="打开官方文档" Command="{Binding OpenDocumentationCommand}" />
            <TextBlock Opacity="0.5" FontSize="12">
                <Run Text="Version " />
                <Run Text="{Binding Version}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>

</UserControl>
