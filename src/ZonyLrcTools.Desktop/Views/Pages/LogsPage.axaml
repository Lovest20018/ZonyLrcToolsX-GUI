<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ZonyLrcTools.Desktop.ViewModels" xmlns:services="using:ZonyLrcTools.Desktop.Services" xmlns:loc="using:ZonyLrcTools.Desktop.Infrastructure.Localization" x:Class="ZonyLrcTools.Desktop.Views.Pages.LogsPage" x:DataType="vm:LogsViewModel">
 <Grid RowDefinitions="Auto,*">
  <StackPanel Spacing="12" Margin="0,0,0,16">
   <TextBlock Text="{Binding Text[Work_LogsTitle]}" Classes="title"/><TextBlock Text="{Binding Text[Work_LogsDescription]}" Classes="secondary"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding Text[Work_Clear]}" Command="{Binding ClearCommand}"/><Button Content="{Binding Text[Work_ExportLogs]}" Command="{Binding ExportCommand}"/></StackPanel>
  </StackPanel>
  <Border Grid.Row="1" Classes="settings-surface" ClipToBounds="True"><Panel>
   <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"><DataGrid.Columns>
    <DataGridTextColumn x:DataType="services:LogEntry" Header="{loc:Localize Work_LogTime}" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="100"/>
    <DataGridTextColumn x:DataType="services:LogEntry" Header="{loc:Localize Work_LogLevel}" Binding="{Binding Level}" Width="100"/>
    <DataGridTextColumn x:DataType="services:LogEntry" Header="{loc:Localize Work_LogMessage}" Binding="{Binding Message}" Width="*"/>
   </DataGrid.Columns></DataGrid>
   <Border Background="{DynamicResource CardBackgroundBrush}" Margin="1,36,1,1" Padding="24" IsVisible="{Binding HasNoEntries}" IsHitTestVisible="False"><TextBlock Text="{Binding Text[Work_LogEmpty]}" Classes="secondary" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
  </Panel></Border>
 </Grid>
</UserControl>
