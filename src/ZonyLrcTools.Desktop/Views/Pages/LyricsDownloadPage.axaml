<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ZonyLrcTools.Desktop.ViewModels" xmlns:loc="using:ZonyLrcTools.Desktop.Infrastructure.Localization" x:Class="ZonyLrcTools.Desktop.Views.Pages.LyricsDownloadPage" x:DataType="vm:LyricsDownloadViewModel" KeyDown="OnKeyDown">
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
  <StackPanel Spacing="4" Margin="0,0,0,16"><TextBlock Text="{Binding LyricsTitle}" Classes="title"/><TextBlock Text="{Binding LyricsDescription}" Classes="secondary"/></StackPanel>
  <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
   <StackPanel Spacing="8">
    <TextBlock Text="{Binding Text[Work_Folder]}" FontWeight="SemiBold"/>
    <Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBox Text="{Binding SelectedFolderPath}" Watermark="{Binding Text[Work_SelectFolder]}" IsReadOnly="True" Margin="0,0,8,0" ToolTip.Tip="{Binding SelectedFolderPath}"/><Button Grid.Column="1" Content="{Binding Text[Work_Browse]}" Command="{Binding SelectFolderCommand}"/>
     <Button Grid.Column="2" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{Binding Text[Work_OpenFolder]}" AutomationProperties.Name="{Binding Text[Work_OpenFolder]}" Margin="8,0,0,0" Width="36" Padding="6"><PathIcon Data="{StaticResource FolderIcon}" Width="16" Height="16"/></Button>
     <Button Grid.Column="3" Command="{Binding CopyPathCommand}" ToolTip.Tip="{Binding Text[Work_CopyPath]}" AutomationProperties.Name="{Binding Text[Work_CopyPath]}" Margin="8,0,0,0" Width="36" Padding="6"><PathIcon Data="M7,2H21V16H18V5H7Z M3,7H16V22H3Z M6,10V19H13V10Z" Width="16" Height="16"/></Button></Grid>
    <WrapPanel>
     <Button Content="{Binding Text[Work_Start]}" Command="{Binding StartDownloadCommand}" Classes="accent" IsVisible="{Binding !IsDownloading}" Margin="0,0,8,4"/>
     <Button Content="{Binding StopText}" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" Margin="0,0,8,4"/>
     <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4"><TextBlock Text="{Binding Text[Work_Parallel]}" VerticalAlignment="Center"/><NumericUpDown x:Name="ConcurrencyInput" Value="{Binding ParallelCount}" IsEnabled="{Binding CanConfigure}" Minimum="1" Maximum="32" Increment="1" Width="104" FormatString="0"/><TextBlock Text="{Binding Text[Work_ParallelHint]}" Classes="secondary" VerticalAlignment="Center"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding OutputPolicy}" Classes="secondary"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
   <TextBlock Text="{Binding Text[Work_EditHint]}" IsVisible="{Binding IsLyrics}" Classes="secondary" Margin="0,0,8,0" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding Text[Work_AlbumEditHint]}" IsVisible="{Binding !IsLyrics}" Classes="secondary" Margin="0,0,8,0" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><CheckBox Content="{Binding Text[Work_ShowPath]}" IsChecked="{Binding ShowPathColumn}"/><Button Content="{Binding Text[Work_Details]}" Command="{Binding ShowPreviewCommand}" IsVisible="{Binding IsLyrics}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="3" ColumnDefinitions="*,0" x:Name="Workspace">
   <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Panel>
     <DataGrid x:Name="SongsGrid" ItemsSource="{Binding MusicFiles}" SelectedItem="{Binding SelectedMusicFile}" IsReadOnly="{Binding IsGridReadOnly}" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" BorderThickness="0" CanUserReorderColumns="False">
      <DataGrid.Columns>
       <DataGridTextColumn x:DataType="vm:MusicFileViewModel" Header="{loc:Localize Column_SongName}" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn x:DataType="vm:MusicFileViewModel" Header="{loc:Localize Column_Artist}" Binding="{Binding Artist}" Width="150"/>
       <DataGridTextColumn x:DataType="vm:MusicFileViewModel" Header="{loc:Localize Column_Status}" Binding="{Binding StatusMessage}" IsReadOnly="True" Width="110"/>
       <DataGridTextColumn x:DataType="vm:MusicFileViewModel" Header="{loc:Localize Column_FilePath}" Binding="{Binding FilePath}" IsReadOnly="True" Width="250" IsVisible="False"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border IsVisible="{Binding HasNoFiles}" Background="{DynamicResource CardBackgroundBrush}" Margin="0,36,0,0" Padding="24" IsHitTestVisible="False"><TextBlock Text="{Binding EmptyStateText}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
    </Panel>
   </Border>
  </Grid>
   <Border Grid.Row="3" x:Name="PreviewPanel" Width="300" HorizontalAlignment="Right" ClipToBounds="True" IsVisible="{Binding IsPreviewOpen}" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="12,0,0,0">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[Work_Preview]}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{Binding Text[Work_Close]}" Command="{Binding ClosePreviewCommand}"/></Grid>
     <TextBlock Grid.Row="1" Text="{Binding SelectedMusicFile.Name}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap"/>
     <TextBlock Grid.Row="2" Text="{Binding SelectedMusicFile.FilePath}" MaxLines="2" TextTrimming="CharacterEllipsis" Classes="secondary" Margin="0,0,0,12" ToolTip.Tip="{Binding SelectedMusicFile.FilePath}"/>
     <TextBox Grid.Row="3" Text="{Binding PreviewText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </Border>
  <Border Grid.Row="4" Classes="card" Margin="0,12,0,0" Padding="12">
   <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding CountsText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{Binding Text[Work_Retry]}" Command="{Binding RetryFailedCommand}" IsVisible="{Binding HasFailures}"/><Button Content="{Binding Text[Work_More]}"><Button.Flyout><MenuFlyout><MenuItem Header="{Binding Text[Work_ExportFailed]}" Command="{Binding ExportFailedCommand}" IsVisible="{Binding IsLyrics}" IsEnabled="{Binding HasFailures}"/><MenuItem Header="{Binding Text[Work_ExportCovers]}" Command="{Binding ExportFailedCommand}" IsVisible="{Binding !IsLyrics}" IsEnabled="{Binding HasFailures}"/></MenuFlyout></Button.Flyout></Button></StackPanel></Grid>
    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" IsIndeterminate="{Binding IsScanning}"/>
    <TextBlock Text="{Binding ScanSummary}" IsVisible="{Binding IsScanning}" Classes="secondary"/>
    <TextBlock Text="{Binding TaskStatus}" Classes="secondary"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
